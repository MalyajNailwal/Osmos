# Required for classification. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# A free-tier OpenRouter model slug (free ones end in ':free'). These rotate
# over time — if this one starts failing, pick a replacement from
# https://openrouter.ai/models?max_price=0 and the classifier picks it up on
# the next run, no code change needed.
CLASSIFIER_MODEL=dots-studio/dots-3-note-preview:free

# Optional: cookie file (Netscape cookies.txt or JSON) for private accounts,
# stories or highlights. Never required for public profile scraping, which is
# the default and only path this PoC uses.
COOKIES_PATH=

# Optional: e.g. http://user:pass@host:8080. The real fix if `osmos collect`
# fails with "please wait a few minutes" / require_login — that's Instagram
# IP-blocking the request, not a bug. Needs a paid, non-shared proxy; free or
# shared ones get IP-blocked the same way. See README's "Known limitation".
PROXY_URL=

DB_PATH=osmos.db
POSTS_PER_PROFILE=12
SCRAPE_CONCURRENCY=3
CLASSIFIER_CONCURRENCY=5

# Optional: a genuine Instagram login (via aiograpi's private API), used
# instead of osmos-core's pasted-cookie tiers when both are set. Stronger
# auth signal — but USE A DISPOSABLE ACCOUNT, never your main one. Automated
# login carries real challenge/ban risk. The session is cached to
# IG_SESSION_PATH after first login, so this only re-authenticates when that
# file is missing or Instagram rejects it.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
IG_SESSION_PATH=ig_session.json
